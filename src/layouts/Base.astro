---
import "../styles/global.css";
---

<html lang="ca" class="bg-black">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>COMPRA</title>
    <meta name="theme-color" content="#000000" />
    <link rel="manifest" href="/manifest.json" crossorigin="use-credentials" />
  </head>
  <body class="text-gray-200 max-w-xl mx-auto px-2 py-2 mb-10">
    <slot />
  </body>
</html>

<script>
  // Desa la posició en enviar qualsevol formulari (beforeunload no és fiable
  // al mòbil) i la restaura un sol cop en carregar la resposta del POST.
  const KEY = "scrollpos";
  try {
    const scrollPosition = sessionStorage.getItem(KEY);
    if (scrollPosition !== null) {
      sessionStorage.removeItem(KEY);
      window.scrollTo(0, +scrollPosition);
    }
  } catch {}

  document.addEventListener("submit", () => {
    try {
      sessionStorage.setItem(KEY, window.scrollY.toString());
    } catch {}
  });
</script>
